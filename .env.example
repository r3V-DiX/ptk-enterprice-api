# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://enterprise:enterprise123@localhost:5434/ptk_enterprise

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6381/0
CELERY_BROKER_URL=redis://localhost:6381/0
CELERY_RESULT_BACKEND=redis://localhost:6381/1

# ─── Security ────────────────────────────────────────────────────────────────
SECRET_KEY=change-me-in-production
ADMIN_SECRET_SCOPE=admin
# Bootstrap secret for issuing the very first admin API key.
# Set to empty string once first key is created.
BOOTSTRAP_SECRET=change-me-before-production

# ─── CORS ────────────────────────────────────────────────────────────────────
# Client-facing API allowed origins
CORS_ORIGINS=["http://localhost:3000"]
# Admin portal allowed origins (kept separate)
ADMIN_PORTAL_ORIGINS=["http://localhost:3001"]

# ─── Admin portal auth (OTP via Resend) ──────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx
EMAIL_FROM=admin@yourdomain.com
# Comma-separated list of emails allowed to log in to the admin portal
ADMIN_EMAILS=you@yourdomain.com
# Session token TTL in seconds (default 24h)
ADMIN_SESSION_TTL=86400
# OTP code TTL in seconds (default 10min)
ADMIN_OTP_TTL=600

# ─── AWS S3 ──────────────────────────────────────────────────────────────────
S3_BUCKET=ptk-enterprise-artifacts
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── External APIs ───────────────────────────────────────────────────────────
VIRUSTOTAL_API_KEY=
SHODAN_API_KEY=

# ─── Scan limits ─────────────────────────────────────────────────────────────
SCAN_EXPIRE_MINUTES=30
MAX_CONCURRENT_SCANS_PER_CLIENT=3
DEFAULT_RATE_LIMIT_RPM=60

# ─── App ─────────────────────────────────────────────────────────────────────
ENV=development
PORT=8002
