          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"target\": \"https://example.com\",\n  \"idempotency_key\": \"my-deploy-20260729-001\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{base_url}}/v1/scans",
              "host": ["{{base_url}}"],
              "path": ["v1", "scans"]
            },
            "description": "Submit the same request a second time with the same `idempotency_key`.\n\nExpected: `200` (not `201`) — the existing scan is returned, no duplicate is created.\n\nRun **Submit Scan** first, then run this to confirm replay returns `200` with the same `scan_id`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
