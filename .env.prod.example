# .env.prod.example — copy to .env.prod on the EC2 and fill in real values
# DO NOT commit .env.prod to git

# ----- Database -----
# Use your existing RDS instance. Create a new database called ptk_enterprise.
# psql -h <rds-host> -U <master-user> -c "CREATE DATABASE ptk_enterprise;"
DATABASE_URL=postgresql://<rds-user>:<rds-password>@<rds-host>:5432/ptk_enterprise

# ----- Redis -----
# Docker Compose starts Redis on the same network — use the service name
REDIS_URL=redis://redis:6379/0

# ----- Security -----
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<generate-a-64-char-hex-string>

# One-time bootstrap secret for creating the very first admin API key.
# Set a strong value, then rotate (or blank it) after first key is issued.
BOOTSTRAP_SECRET=<generate-a-strong-random-string>

# ----- App -----
ENVIRONMENT=production
LOG_LEVEL=INFO

# ----- AWS (for Bedrock / any AWS SDK calls) -----
AWS_DEFAULT_REGION=us-east-1
# If EC2 has an IAM role attached, you can leave these blank.
# Otherwise, set them to an IAM user's keys.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ----- Celery -----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ----- CORS -----
# Comma-separated list of allowed origins for the admin portal
ALLOWED_ORIGINS=https://enterprise-admin.pentoolkit.com

# ----- Rate limiting -----
# Default RPM for keys that don't have a per-key override
DEFAULT_RATE_LIMIT_RPM=60
